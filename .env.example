# Copy to .env and fill in. .env is gitignored — your values never reach the repo.
# Quote any value that contains spaces.
LO_REPO="/path/to/your/repo"        # local checkout the agents clone from
LO_BASE="dev"                       # base branch
LO_TEAM="Your Team"                 # Linear team name
LO_PREFIX="XXX"                     # ticket id prefix, e.g. HYR2
LO_TIER1="Preferred Assignee"       # display name; unassigned is always eligible
LO_TIER2="Fallback Assignee"        # display name
LO_RAM_PER_AGENT="2.5"              # GB budgeted per agent (claude + vite + chrome)
LO_MAX_AGENTS="4"                   # hard ceiling on concurrent agents, whatever
                                    # the RAM math allows

# The status contract — override only if your team renamed the defaults.
# READY is the machine's ball (ready, being worked, conflicting — all of it),
# HUMAN is a person's ball (promoted PR, blocker, decision owed), MERGED is
# what Linear's git automation sets when the PR merges. These names assign
# ROLES; which tickets the loop listens on at all is matched by status TYPE,
# so extra columns ("Shipped" beside "Done") need no config.
#LO_READY_STATUS="Todo"
#LO_HUMAN_STATUS="In Progress"
#LO_MERGED_STATUS="In review"

# Who may order a merge with a "merge" comment on a ticket. Comma-separated,
# case insensitive, Linear display names OR member UUIDs — prefer UUIDs:
# display names are self-editable by any workspace member, so a name here is
# convenience, not authentication. Defaults to LO_TIER1 alone. Everyone
# else's "merge" is answered, not executed.
#LO_MERGE_AUTHORS="948bb07c-fb48-4cab-a48d-55e9c98c3f93"

# Who may steer the loop with ticket comments. Same format; empty means
# everyone who can comment — set it if any integration or automation posts
# comments in your workspace, or their posts will read as human feedback.
#LO_FEEDBACK_AUTHORS=""

# REQUIRED AT INSTALL: uncomment and set to the moment you cut over.
# Comments older than it never surface as feedback — pre-cutover triage
# history carries no 🌙 replies and would otherwise flood in as unanswered
# instructions the first time those tickets move.
#LO_FEEDBACK_SINCE="2026-08-22T00:00:00Z"

# Rolling floor on top of LO_FEEDBACK_SINCE: human comments older than this
# many days never surface as feedback.
#LO_FEEDBACK_MAX_AGE_DAYS="14"

# Moved tickets whose comments are fetched per probe; the watermark only
# advances past what was actually fetched.
#LO_FETCH_CAP="20"

# Where the gate keeps its state (watermark, pending feedback, dispatch
# markers). Override only to test a gate without touching the live one.
#LO_STATE_DIR="$HOME/.claude/linear-orchestrator"
