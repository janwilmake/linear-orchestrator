# Copy to .env and fill in. .env is gitignored — your values never reach the repo.
# Quote any value that contains spaces.
OL_REPO="/path/to/your/repo"        # local checkout the agents clone from
OL_BASE="dev"                       # base branch
OL_TEAM="Your Team"                 # Linear team name
OL_PREFIX="XXX"                     # ticket id prefix, e.g. HYR2
OL_TIER1="Preferred Assignee"       # display name; unassigned is always eligible
OL_TIER2="Fallback Assignee"        # display name
OL_RAM_PER_AGENT="2.5"              # GB budgeted per agent (claude + vite + chrome)
