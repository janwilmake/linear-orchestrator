# Copy to .env and fill in. .env is gitignored — your values never reach the repo.
# Quote any value that contains spaces.
LO_REPO="/path/to/your/repo"        # local checkout the agents clone from
LO_BASE="dev"                       # base branch
LO_TEAM="Your Team"                 # Linear team name
LO_PREFIX="XXX"                     # ticket id prefix, e.g. HYR2
LO_TIER1="Preferred Assignee"       # display name. ONLY these assignees are taken
LO_TIER2="Fallback Assignee"        # display name; leave empty if you have none
LO_ALLOW_UNASSIGNED="0"             # 1 = also take unassigned tickets. Off by
                                    # default: a name on a ticket is the signal
                                    # that it is meant for this loop
LO_ALLOW_BACKLOG="0"                # 1 = fall to Backlog when Todo is empty. Off
                                    # by default: an untriaged ticket is not a
                                    # queued one
LO_OWNER=""                         # short tag identifying THIS instance on the
                                    # forge, e.g. "wijnand". REQUIRED when two
                                    # orchestrators share one repo — the PR
                                    # marker becomes "🌙 lo:<owner>" and each
                                    # instance acts only on its own PRs. Empty
                                    # keeps the bare marker, which is correct
                                    # only for a single orchestrator
LO_RAM_PER_AGENT="2.5"              # GB budgeted per agent (claude + vite + chrome)
LO_MAX_AGENTS="0"                   # ceiling on concurrent agents. 0 = unlimited:
                                    # every tick spawns every slot free RAM
                                    # allows, so the loop ramps to full capacity
                                    # at once instead of one agent at a time
LO_SLOT_SCAN=""                     # agent slots to probe for liveness. Empty =
                                    # what total RAM allows, floor 8
LO_FEEDBACK_SINCE="2026-08-18T17:00:00Z"  # the day this loop began marking its own
                                    # comments. Comments older than this carry no
                                    # marker, so they would all read as human —
                                    # nothing before it is treated as feedback.
LO_FEEDBACK_LOGINS=""               # comma-separated GitHub logins whose comments
                                    # count as feedback, case insensitive. Empty
                                    # means every non-bot login counts.
